<?xml version="1.0" encoding="utf-8"?>
<com.jingxin.pandrive.view.GridBackgroundView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/grid_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="100"
        android:background="@android:color/transparent">

        <!-- Section 1: Date & Time (10%) -->
        <com.jingxin.pandrive.view.DateTimeView
            android:id="@+id/section_datetime"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="10" />

        <!-- Section 2: 仪表综合区（速度仪表盘/指南针/圆形时钟 三页滑动） -->
        <com.jingxin.pandrive.view.DashboardView
            android:id="@+id/dashboard_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="30"
            android:layout_gravity="center_horizontal">

            <com.jingxin.pandrive.view.SpeedometerView
                android:id="@+id/speedometer_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <FrameLayout
                android:id="@+id/compass_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.jingxin.pandrive.view.CompassView
                    android:id="@+id/compass_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:visibility="visible" />

                <com.jingxin.pandrive.view.CompassViewMinimal
                    android:id="@+id/compass_view_minimal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:visibility="gone" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/clock_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.jingxin.pandrive.view.ClockView
                    android:id="@+id/clock_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />

            </FrameLayout>

        </com.jingxin.pandrive.view.DashboardView>

        <!-- Section 3: 车辆信息（里程/油耗/续航）—宽度与仪表盘区域一致，水平居中 -->
        <FrameLayout
            android:id="@+id/section_vehicle_info"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="15"
            android:background="@android:color/transparent">

            <!-- Mileage display: 里程油耗车辆信息 -->
            <com.jingxin.pandrive.view.MileageView
                android:id="@+id/mileage_view"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

        </FrameLayout>

        <!-- Section 4: Navigation Bar (15%) -->
        <com.jingxin.pandrive.view.NavigationBarView
            android:id="@+id/section_navigation"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="15"
            android:background="@android:color/transparent" />

        <!-- 调整区域：空白占位，默认0%，用于调节下方区域的竖向位置 -->
        <View
            android:id="@+id/section_adjust"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0"
            android:background="@android:color/transparent" />

        <!-- Section 5: Lane + Car3D (30%) -->
        <FrameLayout
            android:id="@+id/section_car3d"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="30"
            android:background="@android:color/transparent">

            <com.jingxin.pandrive.view.LaneView
                android:id="@+id/lane_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextureView
                android:id="@+id/texture_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>

    </LinearLayout>

    <!-- 设置按钮（右上角） -->
    <ImageView
        android:id="@+id/theme_button"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_settings"
        android:padding="6dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="设置" />

</com.jingxin.pandrive.view.GridBackgroundView>
